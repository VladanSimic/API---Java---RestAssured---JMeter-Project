<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Tests - DR PROD" parallel="classes" data-provider-thread-count="25" thread-count="1">

    <parameter name="WAIT_TIME" value="30"/>
    <parameter name="ENV" value="DR_PROD"/>
    <parameter name="BROWSER" value="CHROME_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="Smoke Tests - DR PROD">
        <classes>
            <class name="runners.a_smoke.ExtendedSmokePROD"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>