<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Extended Smoke Tests - PREPROD" parallel="classes" data-provider-thread-count="26" thread-count="1">

    <parameter name="WAIT_TIME" value="35"/>
    <parameter name="ENV" value="PRE_PROD"/>
    <parameter name="BROWSER" value="CHROME_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="Extended Smoke Tests - PREPROD">
        <classes>
            <class name="runners.a_smoke.ExtendedSmokePROD"/>
        </classes>
    </test>


    <!--  Failed Tests  -->
    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>