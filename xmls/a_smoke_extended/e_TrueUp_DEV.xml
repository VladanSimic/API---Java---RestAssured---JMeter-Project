<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Tests - AWS STG" parallel="classes" data-provider-thread-count="17" thread-count="17">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="TRUEUP_DEV"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="No"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="Smoke Tests - TrueUp DEV">
        <classes>
            <class name="runners.a_smoke.ExtendedSmoke"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>