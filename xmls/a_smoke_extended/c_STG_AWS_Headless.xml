<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Extended Smoke Tests - AWS STG - Headless" parallel="classes" data-provider-thread-count="26" thread-count="1">

    <parameter name="WAIT_TIME" value="30"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="CHROME_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="Smoke Tests - AWS STG">
        <classes>
            <class name="runners.a_smoke.ExtendedSmoke"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>