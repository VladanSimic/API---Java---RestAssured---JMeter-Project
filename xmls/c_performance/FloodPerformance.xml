<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Performance Tests - AWS STG" parallel="classes" data-provider-thread-count="60" thread-count="1">

    <parameter name="WAIT_TIME" value="90"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="GRID_H"/>
    <parameter name="LOB" value="HS"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="ASSERTIONS" value="No"/>
    <parameter name="RAMP_UP" value="Yes"/>
<!--    <parameter name="RAMP_UP" value="No"/>-->

    <test enabled="true" name="Flood Performance - AWS STG">
        <classes>
            <class name="runners.c_performance.flood.Flood"/>
            <class name="runners.c_performance.flood.Flood60"/>
            <class name="runners.c_performance.flood.FloodAppendix"/>
            <class name="runners.c_performance.flood.FloodRegenerateForms"/>
            <class name="runners.c_performance.flood.FloodMoratorium"/>
            <class name="runners.c_performance.flood.FloodRegenerateFormsStandalone"/>
        </classes>
    </test>

    <!--  Failed Tests  -->
    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>