<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Performance Regression Tests - AWS STG" parallel="classes" data-provider-thread-count="7" thread-count="3">

    <parameter name="WAIT_TIME" value="80"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="CHROME_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="Base Regression Suite Performance">
        <classes>
            <class name="runners.c_performance.cc.NewBusiness_Cancellation_NewBusinessRewrite"/>
            <class name="runners.c_performance.cc.NewBusiness_Cancellation_Reinstatement"/>
            <class name="runners.c_performance.cc.NewBusiness_Endorsement_PolicyExtension"/>
        </classes>
    </test>


    <!--  Failed Tests  -->
    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>