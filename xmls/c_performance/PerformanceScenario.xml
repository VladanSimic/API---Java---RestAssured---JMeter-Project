<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Tests - QA_STG" parallel="classes" data-provider-thread-count="3" thread-count="3">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="QA"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="PGActions" value="No"/>
    <parameter name="SCREENSHOTS" value="No"/>
    <parameter name="DBStore" value="Yes"/>

    <test enabled="true" name="Performance Scenario Tests">
        <classes>
            <class name="runners.performance.PerformanceScenario"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.FailuresRunner"/>
        </classes>
    </test>

</suite>