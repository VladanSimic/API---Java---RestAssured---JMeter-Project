<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Performance US Appendix Scenarios - STG"
       parallel="classes"
       data-provider-thread-count="30"
       thread-count="1">

    <parameter name="WAIT_TIME" value="35"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="JENKINS"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="RAMP_UP" value="Yes"/>

    <test enabled="true" name="Performance US Appendix Scenarios - STG">
        <classes>
            <class name="runners.c_performance.United_States_Performance_Appendix"/>
        </classes>
    </test>

    <!--  Failed Tests  -->
    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>