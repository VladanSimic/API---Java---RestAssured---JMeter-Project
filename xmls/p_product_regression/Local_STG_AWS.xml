<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Product Regression" parallel="classes" data-provider-thread-count="10" thread-count="1">
    <parameter name="WAIT_TIME" value="175"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="No"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="SOFT_ASSERT" value="Yes"/>
    <parameter name="BLOCK_VALIDATION" value="No"/>

    <test enabled="true" name="March - 2025 Iteration">
        <classes>
            <class name="runners.p_product_regression.seven.march.IterationMarch"/>
        </classes>
    </test>

    <test enabled="false" name="P1 and P2 Test - April - April 2025 Iteration">
        <classes>
            <class name="runners.p_product_regression.twenty_five.april.IterationApril25P1Test"/>
            <class name="runners.p_product_regression.twenty_five.april.IterationApril25P2Test"/>
        </classes>
    </test>
    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>