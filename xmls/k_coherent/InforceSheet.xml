<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="AWS STG" parallel="tests" data-provider-thread-count="12" thread-count="1">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="CHROME_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="ASSERTIONS" value="No"/>
    <parameter name="RAMP_UP" value="No"/>

    <test enabled="true" name="InforceSheet">
        <classes>
            <class name="runners.k_coherent.InforceSheet"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>