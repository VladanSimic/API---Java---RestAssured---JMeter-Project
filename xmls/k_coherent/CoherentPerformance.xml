<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Coherent" parallel="tests" data-provider-thread-count="170" thread-count="1">


    <parameter name="WAIT_TIME" value="120"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="GRID_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="RAMP_UP" value="Yes"/>

    <test enabled="true" name="CoherentPerformance">
        <classes>
            <class name="runners.k_coherent.CoherentPerformance"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>