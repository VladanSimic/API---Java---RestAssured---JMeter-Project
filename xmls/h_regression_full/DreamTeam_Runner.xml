<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="STG Regression Universal Runner" parallel="classes" data-provider-thread-count="10" thread-count="1">

    <parameter name="WAIT_TIME" value="45"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="CHROME_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="SOFT_ASSERT" value="Yes"/>
<!--    <parameter name="BLOCK_VALIDATION" value="Yes"/>-->
<!--    <parameter name="RAMP_UP" value="Yes"/>-->
<!--    <parameter name="PGActions" value="Yes"/>-->

    <test enabled="false" name="Full Regression Suite - Carrier Partners">
        <classes>
            <class name="runners.h_regression_full.carrier_partners.CarrierPartners"/>
        </classes>
    </test>
    <test enabled="true" name="Full Regression Suite - Carrier Partners">
        <classes>
            <class name="runners.d_other.renewal_automation_surplus.RenewalAutomationUI"/>
        </classes>
    </test>

    <!--  Failed Tests  -->
    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>