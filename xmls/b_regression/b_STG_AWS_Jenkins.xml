<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression Tests - AWS STG" parallel="classes" data-provider-thread-count="48" thread-count="1">

    <parameter name="WAIT_TIME" value="45"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="JENKINS"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="SOFT_ASSERT" value="Yes"/>
    <parameter name="BLOCK_VALIDATION" value="Yes"/>

    <test enabled="true" name="General Regression - AWS STG">
        <classes>
            <class name="runners.b_regression.UniversalRunnerJenkins"/>
        </classes>
    </test>

    <!--  Failed Tests  -->
    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>