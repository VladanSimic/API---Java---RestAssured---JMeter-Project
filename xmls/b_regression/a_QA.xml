<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression" parallel="tests" data-provider-thread-count="12" thread-count="12">

    <parameter name="WAIT_TIME" value="240"/>
    <parameter name="ENV" value="QA"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <!--  HO  -->
    <test enabled="false" name="Homeowners Regression NB - Homeowner">
        <classes>
            <class name="runners.b_regression.ho.nb.sl.NewBusiness_Homeowners_SingleLocation"/>
        </classes>
    </test>
    <test enabled="false" name="Homeowners Regression NB - Condo">
        <classes>
            <class name="runners.b_regression.ho.nb.sl.NewBusiness_Condo_SingleLocation"/>
        </classes>
    </test>
    <test enabled="false" name="Homeowners Regression NB - Tenants">
        <classes>
            <class name="runners.b_regression.ho.nb.ml.NewBusiness_Tenants_MultipleLocations"/>
        </classes>
    </test>
    <test enabled="false" name="Homeowners Regression NB - Homeowner Multi Location">
        <classes>
            <class name="runners.b_regression.ho.nb.ml.NewBusiness_Condo_MultipleLocations"/>
        </classes>
    </test>
    <test enabled="false" name="Homeowners Regression NB - Condo Multi Location">
        <classes>
            <class name="runners.b_regression.ho.nb.sl.NewBusiness_Tenants_SingleLocation"/>
        </classes>
    </test>
    <test enabled="false" name="Homeowners Regression NB - Tenants Multi Location">
        <classes>
            <class name="runners.b_regression.ho.nb.ml.NewBusiness_Homeowners_MultipleLocations"/>
        </classes>
    </test>

    <!--  PA  -->
    <test enabled="false" name="Personal Auto Regression NB - Private Passenger">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_PrivatePassenger"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Classic Collectors Car">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_ClassicCollectorsCar"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Antique Collectors Car">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_AntiqueCollectorsCar"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Exotic Collectors Car">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_ExoticCollectorsCar"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Golf Carts">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_GolfCarts"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Motor Home">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_MotorHome"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Recreational Trailer">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_RecreationalTrailer"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Motorcycles Mopeds Scooters">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_MotorcyclesMopedsScooters"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Collectors Trailer">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_CollectorsTrailer"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Snowmobiles">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_Snowmobiles"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - All Terrain Vehicles">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_AllTerrainVehicles"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Dune Buggies">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_DuneBuggies"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Regression NB - Travel Trailer">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_TravelTrailer"/>
        </classes>
    </test>

    <!--  EX  -->
    <test enabled="false" name="Excess Liability Regression">
        <classes>
            <class name="runners.b_regression.ex.NewBusiness"/>
            <!--            <class name="runners.b_regression.ex.Endorsement"/>-->
        </classes>
    </test>

    <!--  CO  -->
    <test enabled="true" name="Collections Regression">
        <classes>
            <class name="runners.b_regression.co.NewBusiness"/>
        </classes>
    </test>

    <!--  HS  -->
    <test enabled="false" name="Homeowners Surplus Regression">
        <classes>
            <class name="runners.b_regression.hs.NewBusiness"/>
        </classes>
    </test>

    <!--  PW  -->
    <test enabled="false" name="Personal Watercraft Regression">
        <classes>
            <class name="runners.b_regression.pw.NewBusiness"/>
        </classes>
    </test>

    <!--  ES  -->
    <test enabled="false" name="Excess Surplus Liability Regression">
        <classes>
            <class name="runners.b_regression.es.NewBusiness"/>
        </classes>
    </test>

    <!--  Failed Tests  -->
    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>