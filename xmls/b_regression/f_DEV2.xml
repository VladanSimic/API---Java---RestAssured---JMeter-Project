<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression Tests - DEV2" parallel="classes" data-provider-thread-count="10" thread-count="10">

    <parameter name="WAIT_TIME" value="45"/>
    <parameter name="ENV" value="DEV2"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="SOFT_ASSERT" value="Yes"/>
    <parameter name="BLOCK_VALIDATION" value="Yes"/>

    <test enabled="true" name="General Regression - DEV2">
        <classes>
            <class name="runners.b_regression.dev2.RegressionDEV2"/>
        </classes>
    </test>

    <!--  Failed Tests  -->
    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>