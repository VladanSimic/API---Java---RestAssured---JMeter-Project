<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression Tests - AWS_STG" parallel="classes" data-provider-thread-count="15" thread-count="15">

    <parameter name="WAIT_TIME" value="35"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="CHROME_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <!--  CC  -->
    <test enabled="true" name="Course of Construction Base - Performance Regression">
        <classes>
            <class name="runners.b_regression.cc.PerformanceRegression"/>
        </classes>
    </test>
    <test enabled="false" name="Course of Construction Base - New Business - Cancellation - Reinstatement">
        <classes>
            <class name="runners.b_regression.cc.NewBusiness_Cancellation_Reinstatement"/>
        </classes>
    </test>
    <test enabled="false" name="Course of Construction Base - New Business - Cancellation - New Business Rewrite">
        <classes>
            <class name="runners.b_regression.cc.NewBusiness_Cancellation_NewBusinessRewrite"/>
        </classes>
    </test>
    <test enabled="false" name="Course of Construction Base - New Business - Endorsement - Policy Extension">
        <classes>
            <class name="runners.b_regression.cc.NewBusiness_Endorsement_PolicyExtension"/>
        </classes>
    </test>

    <!--  Failed Tests  -->
    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>