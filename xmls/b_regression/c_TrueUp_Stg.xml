    <test enabled="false" name="Personal Auto Base NB - Motor Home">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_MotorHome"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Base NB - Recreational Trailer">
