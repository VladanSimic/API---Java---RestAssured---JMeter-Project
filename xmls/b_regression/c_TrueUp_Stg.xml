    <test enabled="false" name="Personal Auto Base NB - Exotic Collectors Car">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_ExoticCollectorsCar"/>
        </classes>
    </test>
    <test enabled="false" name="Personal Auto Base NB - Golf Carts">
        <classes>
            <class name="runners.b_regression.pa.nb.NewBusiness_GolfCarts"/>
        </classes>
