<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="AWS STG" parallel="tests" data-provider-thread-count="8" thread-count="8">

    <parameter name="WAIT_TIME" value="90"/>
    <parameter name="ENV" value="AWS_QA"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="No"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="ASSERTIONS" value="Yes"/>
    <parameter name="BLOCK_VALIDATION" value="No"/>

    <test enabled="true" name="General">
        <classes>
            <class name="runners.d_other.General"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>