<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="LC360" parallel="classes" data-provider-thread-count="5" thread-count="5">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="QA"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="USERNAME" value=""/>
    <parameter name="PASSWORD" value=""/>

    <test enabled="true" name="LC360">
        <classes>
            <class name="runners.d_other.lc360.E2Value"/>
            <class name="runners.d_other.lc360.UnderwriterForm"/>
            <class name="runners.d_other.lc360.UnderwriterFormSelfDirectedInterior"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>