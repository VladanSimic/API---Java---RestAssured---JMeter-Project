    <test enabled="false" name="TS596 - E2E Test Set">
        <classes>
            <class name="runners.d_other.primary_flood.e2e.TS596"/>
        </classes>
    </test>

    <test enabled="true" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>