<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Regression CC" parallel="tests" data-provider-thread-count="16" thread-count="16">

    <parameter name="WAIT_TIME" value="45"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="No"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="User Stories">
        <classes>
            <class name="runners.b_regression.cc.us.AllUS"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>