<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="DEVOnly" parallel="classes" data-provider-thread-count="10" thread-count="10">

    <parameter name="WAIT_TIME" value="300"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="No"/>

    <test enabled="true" name="DEVOnly">
        <classes>
            <class name="runners.d_other.DEVOnly"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>