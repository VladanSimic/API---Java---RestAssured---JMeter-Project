<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="User Stories execution" parallel="classes" data-provider-thread-count="20" thread-count="20">

    <listeners>
        <listener class-name="listeners.NotificationFailureTestListener" />
    </listeners>

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="AWS_QA"/>
    <parameter name="BROWSER" value="CHROME_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="DBStore" value="No"/>

    <test enabled="true" name="User stories Jenkins execution">
        <classes>
            <class name="runners.d_other.us.UserStoriesJenkins"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>