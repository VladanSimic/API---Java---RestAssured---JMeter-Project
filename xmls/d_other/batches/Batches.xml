<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Batches" parallel="classes" data-provider-thread-count="28" thread-count="1">
    <parameter name="WAIT_TIME" value="35"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="CHROME_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="SOFT_ASSERT" value="Yes"/>

    <test enabled="true" name="Renewal Batch">
        <classes>
            <class name="runners.d_other.batches.renewals.RenewalBatch"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>