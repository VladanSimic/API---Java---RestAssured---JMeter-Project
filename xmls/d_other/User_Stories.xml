<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="User Stories execution" parallel="classes" data-provider-thread-count="13" thread-count="13">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="AWS_QA"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="User stories execution">
        <classes>
            <class name="runners.d_other.us.UserStories"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>