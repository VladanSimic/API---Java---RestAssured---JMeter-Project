<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="General Suite" parallel="tests" data-provider-thread-count="10" thread-count="2">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="AWS_QA"/>
    <parameter name="BROWSER" value="CHROME_H"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="ASSERTIONS" value="No"/>

    <test enabled="true" name="General">
        <classes>
            <class name="runners.d_other.coherent.mappingCA"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>