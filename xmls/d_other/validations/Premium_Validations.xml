<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Premium Validations" parallel="classes" data-provider-thread-count="10" thread-count="10">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="QA"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="Yes"/>

    <test enabled="false" name="Premium validations">
        <classes>
            <class name="runners.d_other.validations.PremiumValidations_EX"/>
            <class name="runners.d_other.validations.PremiumValidations_PA"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>