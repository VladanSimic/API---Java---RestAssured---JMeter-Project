<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Underwriting Referrals" parallel="classes" data-provider-thread-count="20" thread-count="20">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="QA"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="PGActions" value="No"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="Underwriting Referrals">
        <classes>
            <class name="runners.d_other.referrals.Referrals_EX"/>
            <class name="runners.d_other.referrals.Referrals_HO"/>
            <class name="runners.d_other.referrals.Referrals_PA"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>