<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="OKTA Performance Test" parallel="classes" data-provider-thread-count="20">

    <parameter name="WAIT_TIME" value="120"/>
    <parameter name="ENV" value="QA"/>
    <parameter name="BROWSER" value="CHROME"/>

    <test enabled="true" name="OKTA Performance Test">
        <classes>
            <class name="runners.d_other.OKTAPerformance"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>