<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Utilities" parallel="classes" data-provider-thread-count="10" thread-count="10">

    <parameter name="WAIT_TIME" value="180"/>
    <parameter name="ENV" value="STG"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="Yes"/>

    <test enabled="false" name="Process Transactions">
        <classes>
            <class name="runners.d_other.utilities.ProcessTransactions"/>
        </classes>
    </test>
    <test enabled="false" name="Manually Bind A Policy">
        <classes>
            <class name="runners.d_other.utilities.ManualBindActivePolicy"/>
        </classes>
    </test>
    <test enabled="false" name="Create Endorsement">
        <classes>
            <class name="runners.d_other.utilities.CreateEndorsement"/>
        </classes>
    </test>
    <test enabled="false" name="Bind Rated Quote">
        <classes>
            <class name="runners.d_other.utilities.BindRatedQuote"/>
        </classes>
    </test>
    <test enabled="true" name="Get HHID">
        <classes>
            <class name="runners.d_other.utilities.GetHHID"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>