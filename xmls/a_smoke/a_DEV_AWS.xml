<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Tests - AWS DEV" parallel="classes" data-provider-thread-count="10" thread-count="10">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="AWS_DEV"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="Smoke Tests - AWS DEV">
        <classes>
            <class name="runners.a_smoke.Smoke"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>