<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Tests - DEV2" parallel="tests" data-provider-thread-count="8" thread-count="8">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="DEV2"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="No"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="Smoke Suite">
        <classes>
            <class name="runners.a_smoke.SmokeDEV2"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>