<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Tests - QA2" parallel="tests" data-provider-thread-count="8" thread-count="8">

    <parameter name="WAIT_TIME" value="60"/>
    <parameter name="ENV" value="AWS_QA"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="No"/>
    <parameter name="SCREENSHOTS" value="Yes"/>
    <parameter name="PGActions" value="No"/>

    <test enabled="true" name="General Regression - QA2">
        <classes>
            <class name="runners.a_smoke.SmokeQA2"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>