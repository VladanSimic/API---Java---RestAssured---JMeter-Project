<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Smoke Tests - AWS_STG" parallel="tests" data-provider-thread-count="10" thread-count="10">

    <parameter name="WAIT_TIME" value="30"/>
    <parameter name="ENV" value="AWS_STG"/>
    <parameter name="BROWSER" value="CHROME"/>
    <parameter name="QUIT" value="Yes"/>
    <parameter name="SCREENSHOTS" value="Yes"/>

    <test enabled="true" name="Smoke Suite - CC">
        <classes>
            <class name="runners.a_smoke.SmokeCC"/>
        </classes>
    </test>

    <test enabled="false" name="Rerun Failures">
        <classes>
            <class name="runners.d_other.FailuresRunner"/>
        </classes>
    </test>

</suite>